# Production build overrides (loaded by `vite build`, higher priority than .env).
# Same-origin API — nginx proxies /api/ to the backend on :5005 for every domain.
VITE_API_URL=/api/v1
# Browser (referrer-restricted) key for precise reverse-geocoding of the auto-detected location.
# Without it production silently falls back to OpenStreetMap, which only knows the area as "Indore City, Juni Indore Tahsil".
VITE_GOOGLE_MAPS_API_KEY=AIzaSyBRHvhhxVDQyYkOryyo2IA19GuDFqsYD30
